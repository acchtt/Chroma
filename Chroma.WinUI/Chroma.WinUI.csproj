<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Chroma</RootNamespace>
    <AssemblyName>Chroma</AssemblyName>
    <ApplicationIcon>Assets\Chroma.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.10.4</Version>
    <AssemblyVersion>1.10.4.0</AssemblyVersion>
    <FileVersion>1.10.4.0</FileVersion>
    <InformationalVersion>v1.10.4</InformationalVersion>
    <Product>Chroma</Product>
    <AssemblyTitle>Chroma</AssemblyTitle>
    <Authors>acchtt</Authors>
    <Description>Automatic per-game saturation profiles with native Intel, NVIDIA, and AMD GPU control.</Description>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--
      Release packages use the Windows App SDK single-file deployment model.
      The WinUI/.NET runtime and brand artwork are bundled into Chroma.exe.
      The native monitoring agent remains beside the launcher as the only
      required companion file. Compression reduces the installed executable
      size while preserving the same portable two-file distribution.
    -->
    <PublishSingleFile Condition="'$(SelfContained)' == 'true'">true</PublishSingleFile>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <IncludeAllContentForSelfExtract Condition="'$(SelfContained)' == 'true'">true</IncludeAllContentForSelfExtract>
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <NativeAgentSourcePath Condition="'$(NativeAgentSourcePath)' == ''">$(MSBuildProjectDirectory)\..\build\native-$(Platform)\$(Configuration)\Chroma.Agent.exe</NativeAgentSourcePath>
    <NativeAgentPdbSourcePath Condition="'$(NativeAgentPdbSourcePath)' == ''">$(MSBuildProjectDirectory)\..\build\native-$(Platform)\$(Configuration)\Chroma.Agent.pdb</NativeAgentPdbSourcePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Chroma.ico"
                      LogicalName="Chroma.Brand.Chroma.ico" />
    <EmbeddedResource Include="Assets\Chroma.png"
                      LogicalName="Chroma.Brand.Chroma.png" />
  </ItemGroup>

  <!--
    The native tray agent is a required runtime companion.  Include it in both
    normal build output and publish output so Chroma.exe can be launched
    from Visual Studio/bin or from dist without losing the agent.
  -->
  <ItemGroup Condition="Exists('$(NativeAgentSourcePath)')">
    <Content Include="$(NativeAgentSourcePath)">
      <Link>Chroma.Agent.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Release' and Exists('$(NativeAgentPdbSourcePath)')">
    <None Include="$(NativeAgentPdbSourcePath)">
      <Link>Chroma.Agent.pdb</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
